# 23 款宋 Pro DM-i 运行环境变量（op 启动前 source）
# 说明：值可在不改代码的前提下覆盖；带 "建议" 的项是调参起点，不是定论。

# ---- 车型 ----
# 平台已在 values.py 里登记为 BYD_SONG_PRO_DMI_23（复制 22 款指纹）
# 如果实车认不出，先试下面这行强制指定，再考虑补指纹
# FINGERPRINT="BYD_SONG_PRO_DMI_23"
FINGERPRINT="BYD_SONG_PRO_DMI_23"

# ---- 摄像头（PC 版必需）----
USE_WEBCAM=1
# 两颗都是 DECXIN 同型号模块，USB 序列号都是 01.00.00 → 描述符层面完全一样，
# 区别只在**装的镜头**：一颗普通视角，一颗鱼眼超广角。
#
# 【主路径】CAM_AUTODETECT=1：按画面特征自动识别
#   camerad 启动时各拍几帧，四角死黑（圆形像场）= 鱼眼 → 广角，其余 → 路面。
#   这样换 USB 口、甚至把两颗物理对调，都不用改下面的路径。
#   识别逻辑在 cpv8/tools/webcam/camdetect.py，可单独跑：
#     cd ~/openpilot/cpv8 && ./.venv/bin/python -m tools.webcam.camdetect
CAM_AUTODETECT=1
#
# 【兜底】自动识别失败时（例如摄像头正被预览程序占用）用下面这两个 by-path。
# ⚠️ 换 USB 口后 by-path 会变，需要手工更新；端口号见注释。
#    端口 10.3 = 普通视角(路面)，端口 10.4 = 鱼眼(广角)
ROAD_CAM=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:10.3:1.0-video-index0
# 广角（双摄时打开）
# ⚠️ 2026-11-02 联调时暂时关掉：这台笔记本（8 核 / Intel UHD 620）跑双摄时
#    camerad 要吃掉 ~2.7 核、modeld 又跟不上，整机 load 冲到 22。
#    单摄能把负载砍一半，modeld 才有机会追平帧率。等跑通之后再开回来。
#WIDE_CAM=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:10.4:1.0-video-index0
# 想退回裸编号就改成： ROAD_CAM=2 / WIDE_CAM=4

# ---- 鱼眼去畸变 ----
# openpilot 的广角通路是**纯针孔模型**（common/transformations/model.py 的
# get_warp_matrix() 只有 3x3 单应，全仓没有任何畸变项；UI 里还留着
# `// TODO: use proper perspective transform?`）。所以原始鱼眼图必须先掰直，
# 否则 modeld 拿到的几何是错的。
# 参数文件里的 K/D 现在是实测估计（等距模型，尚未棋盘格标定）。
WIDE_UNDISTORT=1
WIDE_LENS_FILE=/home/cosmos/openpilot/launch/env/wide_lens.json

# 分辨率/帧率：两路共用同一条 USB 2.0 总线，等时带宽有限
# ❌ 两路都 1920x1080 → 后开的那路 VIDIOC_STREAMON: No space left on device
# ✅ 实测 路面 1920x1080@20 + 广角 1280x720@20 可双路稳定运行
ROAD_WIDTH=1920
ROAD_HEIGHT=1080
# 帧率必须保持 20：roadCameraState 在 services.py 里期望 20Hz±20%，
# 降到 10 会触发 cameraFrameRate(NO_ENTRY)，一样拦激活。别往这里降。
ROAD_FPS=20
WIDE_WIDTH=1280
WIDE_HEIGHT=720

# 内参：先用 2320/605 起步，实际用棋盘格标定后再改（见 docs 第 5 节）
ROAD_FOCAL=2320.0
WIDE_FOCAL=605.0

# ---- 驾驶员监控 ----
# PC 版一般没有 DMS 摄像头，先关；装了红外摄像头再改 0
# ⚠️ NO_DM 在本分支是死变量（全仓无消费方）。真正生效的是 Params 的 DisableDM：
#    tools/webcam/camerad.py 读 DisableDM，为 0 时会把 DRIVER_CAM(默认 2) 也打开。
#    manager 启动时会给未设置的 DisableDM 写默认值 1，所以默认仍是关的。
NO_DM=1

# ---- 原车前雷达（毫米波）----
# 宋 Pro 的雷达在 CAN-FD 私有总线，本分支 0x374 解析是经典帧写法，未验证
# 先保持注释，等抓包确认后再打开
#BYD_RADAR=1

# ---- 外部陀螺仪（可选，USB 串口）----
# 本分支（cpv8）走 sensord 的「PC 串口」分支，变量名是 SERIAL_DEVICE，默认 /dev/ttyUSB0。
# 注意：sensord 在 PC 上默认不启动（process_config.py:100 `enabled=not PC`），要先把它拉起来，
# 只设 SERIAL_DEVICE 没用。详见 docs/IMU-陀螺仪接入调研.md
#SERIAL_DEVICE=/dev/ttyUSB0

# 下面这个 JY62 变量是 cpv9-pc-dev / helper 注入版的口径，**本分支不认**，别设：
# JY62=2   # 2=sensor_jy62, 1=locationd_jy62
